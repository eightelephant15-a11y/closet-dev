APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://stylist:stylist@localhost:5432/stylist
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
# Firebase: path to service-account JSON (never commit). Empty + FIREBASE_EMULATOR_HOST => emulator.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=stylist-dev
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
POLICY_VERSION=2026-01
# AWS: service-account JSON content injected from Secrets Manager (leave empty locally)
FIREBASE_CREDENTIALS_JSON=
# Empty => export files stored on local disk under EXPORT_DIR; set to an S3 bucket in AWS
EXPORT_BUCKET=
EXPORT_DIR=.exports

# ---- closet (phase 2) ----
STORAGE_BACKEND=local            # local (dev only) | s3
STORAGE_DIR=.storage
IMAGES_BUCKET=                   # required when STORAGE_BACKEND=s3
QUEUE_BACKEND=arq                # arq (Redis) | eager (inline, tests)
VISION_DAILY_CAP=200             # analyses per user per UTC day
# Vision provider is chosen by the remote-config flag `vision_provider` (fake | claude).
# The Claude adapter reads these (UNVERIFIED until you run `make eval-vision` with a real key):
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
VISION_EFFORT=low
